        "type": "string",
        "required": true,
        "description": "Member identifier",
        "sensitive": true,
        "minimum": null,
        "enum": null
      },
      "account_type": {
        "type": "string",
        "required": true,
        "description": null,
        "sensitive": false,
        "minimum": null,
        "enum": [
          "Savings",
          "Money Market"
        ]
      },
      "nickname": {
        "type": "string",
        "required": true,
        "description": null,
        "sensitive": false,
        "minimum": null,
        "enum": null
      },
      "initial_deposit": {
        "type": "number",
        "required": true,
        "description": null,
        "sensitive": false,
        "minimum": 0.0,
        "enum": null
      }
    },
    "outputs": {
      "confirmation_id": {
        "type": "string",
        "description": null,
        "sensitive": false
      },
      "new_account_id": {
        "type": "string",
        "description": null,
        "sensitive": false
      }
    },
    "outcomes": [
      "MEMBER_NOT_FOUND",
      "MEMBER_RESTRICTED",
      "VALIDATION_ERROR"
    ]
