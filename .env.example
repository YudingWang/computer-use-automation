# OpenAI — used only for discovery (the model is not in the replay loop)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Leave unset unless the model allows it. gpt-5.x rejects temperature=0.
# Optional: Azure/proxy. Default is https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional overrides
CUAS_DEMO_HOST=127.0.0.1
CUAS_DEMO_PORT=8765
